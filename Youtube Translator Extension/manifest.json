{
  "manifest_version": 3,
  "name": "YouTube Subtitle Translator",
  "version": "1.0",
  "description": "Click any word in YouTube subtitles to translate it.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}